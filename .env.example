# Local HMAC secret for sandbox token signing (override in production)
CAPTCHA_LOCAL_HMAC_SECRET=change-me-to-a-strong-random-secret
CAPTCHA_TOKEN_TTL_SECONDS=120

# Official publicly documented provider test keys (defaults shown)
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET_KEY=0x0000000000000000000000000000000000000000
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Set to true only when testing with outbound internet access to provider siteverify endpoints
ENABLE_LIVE_PROVIDER_CALLS=false

# Optional third-party solver API keys
TWOCAPTCHA_API_KEY=
CAPSOLVER_API_KEY=

BROWSER_TIMEOUT_SECONDS=15
